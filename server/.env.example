# Copy to .env on the server and `chmod 600 .env`.

# Exact origin of the web app (Origin header check / CSRF).
APP_ORIGIN=https://vat.example.com

# 32 random bytes, base64:  openssl rand -base64 32
# Losing this key makes stored files unreadable — back it up somewhere safe.
DATA_ENCRYPTION_KEY=

# Cloudflare Access (Zero Trust) — both apps' Application Audience (AUD) tags.
ACCESS_MODE=enforce
CF_ACCESS_TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com
CF_ACCESS_WEB_AUD=
CF_ACCESS_API_AUD=
# Who may use the app (comma-separated). Must match the Cloudflare Access policy;
# checked again here against the verified Access token. Required.
ALLOWED_EMAILS=you@example.com

# Cloudflare Tunnel token for the cloudflared sidecar.
TUNNEL_TOKEN=

# Optional tuning
CONVERT_WORKERS=2
CONVERT_TIMEOUT_MS=90000
MAX_INPUT_MB=25
MAX_TEMPLATE_MB=25
