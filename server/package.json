{
  "name": "output-vat-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "parity": "tsx test/parity/run-parity.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "node-xlsx": "^0.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
